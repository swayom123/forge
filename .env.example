FORGE_DATABASE_URL=sqlite:///./forge.db
FORGE_LOG_LEVEL=INFO
FORGE_REPOSITORY_MAX_FILES=10000
FORGE_REPOSITORY_MAX_FILE_BYTES=1000000
# Additional comma-separated directory names; secure defaults always remain active.
FORGE_REPOSITORY_IGNORED_DIRECTORIES=.idea,.vscode
# A future model provider may read a key from its own environment variable.

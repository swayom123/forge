FORGE_DATABASE_URL=sqlite:///./forge.db
FORGE_LOG_LEVEL=INFO
FORGE_REPOSITORY_MAX_FILES=10000
FORGE_REPOSITORY_MAX_FILE_BYTES=1000000
# Additional comma-separated directory names; secure defaults always remain active.
FORGE_REPOSITORY_IGNORED_DIRECTORIES=.idea,.vscode
FORGE_WORKTREE_ROOT=/tmp/forge-worktrees
FORGE_WORKTREE_MAX_FILES=20000
FORGE_WORKTREE_MAX_BYTES=500000000
FORGE_PATCH_MAX_BYTES=1000000
FORGE_SANDBOX_BWRAP_PATH=/usr/bin/bwrap
FORGE_SANDBOX_PRLIMIT_PATH=/usr/bin/prlimit
FORGE_SANDBOX_TIMEOUT_SECONDS=120
FORGE_SANDBOX_CPU_SECONDS=60
FORGE_SANDBOX_MEMORY_BYTES=1073741824
FORGE_SANDBOX_FILE_BYTES=52428800
FORGE_SANDBOX_OUTPUT_BYTES=1000000
FORGE_SANDBOX_MAX_PROCESSES=64
FORGE_SANDBOX_MAX_OPEN_FILES=256
FORGE_VERIFICATION_MAX_FAILED_ATTEMPTS=3
# A future model provider may read a key from its own environment variable.
